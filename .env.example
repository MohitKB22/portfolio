# ---------------------------------------------------------------------------
# Public site configuration (exposed to the browser)
# ---------------------------------------------------------------------------
# Canonical production URL — drives sitemap, RSS, OpenGraph and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://mohitbarse.vercel.app"

# ---------------------------------------------------------------------------
# EmailJS — powers the contact form (https://dashboard.emailjs.com)
# All three are required to send. Without them the form degrades gracefully to
# a pre-filled mailto: link, so the build and the page still work.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# GitHub — optional. A token with `public_repo` scope lifts the API rate limit
# from 60/hr to 5000/hr for the live repo-stats widget. Server-side only.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=""

# ---------------------------------------------------------------------------
# Visual / performance flags
# ---------------------------------------------------------------------------
# Animated WebGL neural field in the hero (React Three Fiber). Off by default:
# a continuously rendering canvas is the single most expensive thing on the page
# and makes the site feel sluggish on integrated graphics or on battery. The
# default is a static SVG constellation that looks near-identical when still.
NEXT_PUBLIC_ENABLE_WEBGL="false"

# Lenis JavaScript smooth scrolling. Off by default: it replaces the browser's
# native off-main-thread scrolling with a rAF loop, which adds input latency and
# is the usual cause of "scrolling feels laggy" on a trackpad.
NEXT_PUBLIC_ENABLE_SMOOTH_SCROLL="false"

# ---------------------------------------------------------------------------
# Build flags — set to "true" only for Docker image builds (standalone output)
# ---------------------------------------------------------------------------
DOCKER_BUILD="false"
